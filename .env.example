# Supabase Configuration (Free Tier at https://supabase.com)
# When provided, the app persists to PostgreSQL & Supabase Storage.
# When omitted, the app runs in LocalStorage / Demo Mode automatically!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Local Development Admin Credentials (used in Demo Mode)
VITE_ADMIN_EMAIL=admin@classnetwork.local
VITE_ADMIN_PASSWORD=AdminClass2026!

# Community Branding
VITE_COMMUNITY_NAME="Class Network"
VITE_COHORT_NAME="Online Telegram Class Cohort"
